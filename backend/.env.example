# Threat-intelligence credentials: inject via a secret manager or local environment.
# Never commit actual keys.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
THREATFOX_AUTH_KEY=
THREATFOX_API_KEY=
URLHAUS_AUTH_KEY=
URLHAUS_API_KEY=

# Geolocation provider policy. The default is ipapi only; review its current
# provider terms/privacy conditions before allowing production egress.
MAILTRACE_GEOLOCATION_PROVIDERS=ipapi
# Optional shared cache URL; use an authenticated/TLS-protected Redis in production.
MAILTRACE_GEOLOCATION_REDIS_URL=
# IPinfo is an explicit opt-in: provider must be allowlisted, token configured,
# and organizational/legal approval recorded before setting this to true.
MAILTRACE_GEOLOCATION_IPINFO_APPROVED=false
IPINFO_TOKEN=

# Domain DNS/MX enrichment is opt-in because it sends queried domain names to
# the host-configured DNS resolver. WHOIS/domain-age lookup has no provider.
MAILTRACE_DOMAIN_INTELLIGENCE_ENABLED=false

# Optional JSON brand-domain candidate registry override. The default is the
# versioned backend/config/brand_domains.json file; keep provenance and review date.
MAILTRACE_BRAND_DOMAIN_LIST=

# Optional endpoint overrides for approved proxies/test environments.
ABUSEIPDB_API_URL=
VIRUSTOTAL_API_URL=
THREATFOX_API_URL=
URLHAUS_API_URL=
